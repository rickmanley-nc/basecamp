# Copy this file to basecamp.env for Docker Compose, or to an
# admin-controlled path such as /etc/basecamp/basecamp.env on a Linux host.
# The real env file is intentionally ignored. Pass it explicitly with
# docker compose --env-file basecamp.env ...
# If you store the real env file outside infra/, set BASECAMP_CONFIG_SOURCE
# to that absolute host path so container backups can include it.

BASECAMP_APP_VERSION=0.8.0
BASECAMP_PUBLIC_URL=http://basecamp.local:8080
BASECAMP_WEB_URL=http://basecamp.local:8080
BASECAMP_HTTP_PORT=8080

# Generate a real value outside git, for example:
# openssl rand -hex 32
BASECAMP_ADMIN_TOKEN=change-me-generate-a-random-token

# local requires username/password accounts created with pnpm ops:user:create.
# none is for local developer-only testing.
BASECAMP_AUTH_MODE=local

# v0.8 cloud pilot foundation still uses SQLite in a persistent container volume.
BASECAMP_DB_PATH=/var/lib/basecamp/basecamp.sqlite
BASECAMP_STORAGE_DIR=/var/lib/basecamp/storage
BASECAMP_BACKUP_DIR=/var/backups/basecamp
BASECAMP_CONFIG_SOURCE=./basecamp.env
BASECAMP_BACKUP_INTERVAL_SECONDS=86400
BASECAMP_BACKUP_STALE_HOURS=30

# Allowed values: lan, vpn, reverse_proxy.
BASECAMP_REMOTE_ACCESS=lan
BASECAMP_LOG_LEVEL=info
