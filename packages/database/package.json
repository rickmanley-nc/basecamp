{
  "name": "@basecamp/database",
  "version": "0.0.0",
  "private": true,
  "description": "Basecamp database schema, migrations, seed workflow, and repositories.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "backup": "tsx scripts/backup.ts",
    "db:reset": "tsx scripts/reset-dev-db.ts",
    "export": "tsx scripts/export-data.ts",
    "import": "tsx scripts/import-data.ts",
    "postgres:import": "tsx scripts/postgres-import.ts",
    "postgres:migrate": "tsx scripts/postgres-migrate.ts",
    "postgres:status": "tsx scripts/postgres-status.ts",
    "qa:reset": "tsx scripts/qa-reset.ts",
    "qa:seed": "tsx scripts/qa-seed.ts",
    "user:disable": "tsx scripts/disable-user.ts",
    "user:create": "tsx scripts/create-user.ts",
    "restore": "tsx scripts/restore.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@basecamp/content": "workspace:*",
    "@basecamp/domain": "workspace:*",
    "@basecamp/sync": "workspace:*",
    "pg": "^8.23.0"
  }
}
